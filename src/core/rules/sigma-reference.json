      "name": "utf16le",
      "group": "String Modifiers",
      "description": "Transforms value to UTF16-LE encoding, e.g. `cmd` > `63 00 6d 00 64 00`"
    },
    {
      "name": "utf16be",
      "group": "String Modifiers",
      "description": "Transforms value to UTF16-BE encoding, e.g. `cmd` > `00 63 00 6d 00 64`"
    },
    {
      "name": "utf16",
      "group": "String Modifiers",
      "description": "Prepends a [byte order mark](https://en.wikipedia.org/wiki/Byte_order_mark) and encodes UTF16, e.g. `cmd` > `FF FE 63 00 6d 00 64 00`"
    },
    {
